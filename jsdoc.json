{
  "source": {
    "include": ["src", "shared", "api"],
    "includePattern": "\\.(js|jsx)$",
    "excludePattern": "(\\.test\\.(js|jsx)$|node_modules)"
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "destination": "docs/api",
    "recurse": true,
    "readme": "./README.md"
  },
  "templates": {
    "cleverLinks": true
  }
}
