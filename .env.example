# Groq API Configuration (FREE!)
# Get your free API key from: https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here

# This key is read only by the server-side /api/categorize function
# (see api/categorize.js) and is never bundled into the browser build —
# do NOT prefix it with VITE_, which would expose it client-side.
#
# Groq offers a generous free tier with fast inference using Llama 3.3 70B model.
